    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "docx": "^9.11.0",
    "file-saver": "^2.0.5",
    "katex": "^0.19.0",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
