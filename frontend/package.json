{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "copy-excalidraw-assets": "node -e \"const fs=require('fs'); const src='node_modules/@excalidraw/excalidraw/dist/prod/fonts'; const dest='public/fonts'; if(fs.existsSync(src)){fs.mkdirSync(dest, {recursive:true}); fs.cpSync(src, dest, {recursive:true}); console.log('Excalidraw fonts copied to public/fonts');}\"",
    "postinstall": "npm run copy-excalidraw-assets"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/ssr": "^0.12.7",
